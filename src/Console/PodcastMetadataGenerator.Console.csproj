<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PodcastMetadataGenerator.Console</RootNamespace>
    <AssemblyName>outrokit</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>outrokit</ToolCommandName>
    <PackageId>OutroKit</PackageId>
    <Title>OutroKit</Title>
    <PackageVersion>1.2.1</PackageVersion>
    <Authors>James Montemagno</Authors>
    <Description>OutroKit writes the titles, descriptions, chapters, and subtitles for your episode from its transcript, video, or audio, using GitHub Copilot. It can also burn captions into a video.</Description>
    <PackageTags>outrokit;podcast;video;youtube;metadata;ai;copilot;transcripts;chapters;srt;subtitles;captions</PackageTags>
    <PackageProjectUrl>https://outrokit.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jamesmontemagno/podcast-metadata-generator</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Enable reflection-based JSON serialization -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!--
    The app's original package. A tool package cannot depend on another package, so the renamed
    app is also packed under its old ID and command, with a marker file that makes it tell people
    to move to OutroKit. Pack it with -p:LegacyPackage=true; .github/scripts/pack-tool.sh does both.
  -->
  <PropertyGroup Condition="'$(LegacyPackage)' == 'true'">
    <PackageId>PodcastMetadataGenerator</PackageId>
    <ToolCommandName>podcast-metadata-generator</ToolCommandName>
    <Title>Podcast Metadata Generator (now OutroKit)</Title>
    <Description>This package has been renamed to OutroKit: run "dnx OutroKit" or "dotnet tool install -g OutroKit". It still installs the same app, which writes the titles, descriptions, chapters, and subtitles for your episode using GitHub Copilot.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(LegacyPackage)' == 'true'">
    <None Update="renamed-package.txt" Pack="true" PackagePath="tools/$(TargetFramework)/any/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\PodcastMetadataGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
