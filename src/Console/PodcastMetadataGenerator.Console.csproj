<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PodcastMetadataGenerator.Console</RootNamespace>
    <AssemblyName>outrokit</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- NuGet Package Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>outrokit</ToolCommandName>
    <!-- The package keeps its original ID so existing installs and `dnx PodcastMetadataGenerator` keep working. -->
    <PackageId>PodcastMetadataGenerator</PackageId>
    <Title>OutroKit</Title>
    <PackageVersion>1.2.1</PackageVersion>
    <Authors>James Montemagno</Authors>
    <Description>OutroKit writes the titles, descriptions, chapters, and subtitles for your episode from its transcript, video, or audio, using GitHub Copilot. It can also burn captions into a video. Formerly Podcast Metadata Generator.</Description>
    <PackageTags>outrokit;podcast;video;youtube;metadata;ai;copilot;transcripts;chapters;srt;subtitles;captions</PackageTags>
    <PackageProjectUrl>https://outrokit.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jamesmontemagno/podcast-metadata-generator</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Enable reflection-based JSON serialization -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\PodcastMetadataGenerator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
